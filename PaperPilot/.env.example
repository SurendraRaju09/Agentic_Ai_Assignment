# ============================================================
# PaperPilot AI — .env.example
# Copy this file to .env and fill in your values.
# The .env file is NEVER committed to git (add it to .gitignore).
# ============================================================

# ----- LLM Provider -----
# Choose: "ollama" (local, free) or "groq" (cloud API, free tier available)
LLM_PROVIDER=ollama

# ----- Ollama Configuration (Primary) -----
# Your installed model. Check available models with: ollama list
OLLAMA_MODEL=qwen2.5-coder:7b
# Ollama runs on this URL by default. Do not change unless you modified Ollama's port.
OLLAMA_BASE_URL=http://localhost:11434
# Temperature controls creativity: 0.0 = deterministic, 1.0 = creative.
# For research summarization, low temperature (0.1-0.3) is better for accuracy.
OLLAMA_TEMPERATURE=0.1

# ----- Groq Configuration (Optional Fallback) -----
# Get a free API key at: https://console.groq.com
# Only needed if LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ----- ChromaDB -----
# Local directory where ChromaDB stores vector embeddings.
# Created automatically when the app first processes a PDF.
CHROMA_PERSIST_DIR=./chroma_db

# ----- Application Paths -----
# Where generated .pptx files are saved for download.
OUTPUT_DIR=./outputs
# Where uploaded PDF files are temporarily stored during processing.
DATA_DIR=./data

# ----- RAG Parameters -----
# chunk_size: Max characters per chunk (1000 chars ≈ 150-200 words)
CHUNK_SIZE=1000
# chunk_overlap: Characters shared between adjacent chunks.
# Prevents important sentences from being cut at chunk boundaries.
CHUNK_OVERLAP=150
# Default number of chunks to retrieve per query.
MAX_CHUNKS_PER_RETRIEVAL=6
# Summarizer retrieves more chunks to ensure broad paper coverage.
SUMMARIZER_K=10
# Viva agent retrieves more to cover limitations/future work sections.
VIVA_K=8
